#!/usr/bin/env python3
"""Minimal 1min.AI caller for the GitHub runner (same CLI/stderr contract as the box helper that news.py expects).
Usage: onemin [-m model] [-a agent] "prompt"
- Key comes ONLY from env ONEMIN_AI_API_KEY (an Actions secret). It is never printed or logged.
- Credits are logged to usage/onemin-usage.tsv (committed with the state).
- Hard caps (simple port of the box 5.5M stop): at most DAILY_CAP calls per CT day and MONTHLY_CAP credits per
  calendar month FROM THIS REPO. Over a cap -> exit 2 with "BUDGET STOP" on stderr, no API call.
NOTE: the box helper's monthly team total does not see this file; add it to team usage totals."""
import json, os, sys, urllib.request, urllib.error, datetime
from zoneinfo import ZoneInfo
ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LOG = os.path.join(ROOT, "usage", "onemin-usage.tsv")
DAILY_CAP = int(os.environ.get("ONEMIN_DAILY_CAP", "10"))
MONTHLY_CAP = int(os.environ.get("ONEMIN_MONTHLY_CAP", "300000"))
args = sys.argv[1:]; model = "gpt-4o-mini"; agent = "paper-trader"
while len(args) > 1 and args[0] in ("-m", "-a"):
    if args[0] == "-m": model = args[1]
    else: agent = args[1]
    args = args[2:]
if not args or (args[0].startswith("-") and args[0] != "--usage"):
    print("usage: onemin [-m model] [-a agent] prompt | onemin --usage", file=sys.stderr); sys.exit(1)
prompt = args[0]
key = os.environ.get("ONEMIN_AI_API_KEY")
if not key and prompt != "--usage": print("ONEMIN_AI_API_KEY not set", file=sys.stderr); sys.exit(1)
now = datetime.datetime.now(ZoneInfo("America/Chicago")).replace(tzinfo=None)   # naive CT, same format as the box log
day = now.strftime("%Y-%m-%d"); month = now.strftime("%Y-%m")
calls_today = used_month = 0
if os.path.exists(LOG):
    for l in open(LOG):
        p = l.rstrip("\n").split("\t")
        if len(p) < 4: continue
        if p[0].startswith(day): calls_today += 1
        if p[0].startswith(month):
            try: used_month += int(p[3])
            except ValueError: pass
if prompt == "--usage":   # same output shape as the box helper (read by weekly_scorecard.py); no API call
    by = {}
    if os.path.exists(LOG):
        for l in open(LOG):
            p = l.rstrip("\n").split("\t")
            if len(p) >= 4 and p[0].startswith(month) and p[3].isdigit(): by[p[1]] = by.get(p[1], 0) + int(p[3])
    print(f"Month {month} total: {sum(by.values())} of {MONTHLY_CAP:,} (GitHub runner only)")
    for k, v in by.items(): print(f"  agent {k}: {v}")
    sys.exit(0)
if calls_today >= DAILY_CAP:
    print(f"BUDGET STOP: {calls_today} calls today (cap {DAILY_CAP}/day)", file=sys.stderr); sys.exit(2)
if used_month >= MONTHLY_CAP:
    print(f"BUDGET STOP: {used_month:,} credits this month from GitHub runner (cap {MONTHLY_CAP:,})", file=sys.stderr); sys.exit(2)
body = json.dumps({"type": "UNIFY_CHAT_WITH_AI", "model": model, "promptObject": {"prompt": prompt}}).encode()
req = urllib.request.Request("https://api.1min.ai/api/chat-with-ai", data=body,
                             headers={"API-KEY": key, "Content-Type": "application/json"})
try:
    d = json.load(urllib.request.urlopen(req, timeout=170))
except urllib.error.HTTPError as e:
    print(f"1min error {e.code}", file=sys.stderr); sys.exit(1)
except Exception as e:
    print(f"1min error {type(e).__name__}", file=sys.stderr); sys.exit(1)
r = d.get("aiRecord", {}); cr = int((r.get("metadata") or {}).get("credit") or 0)
os.makedirs(os.path.dirname(LOG), exist_ok=True)
with open(LOG, "a") as f: f.write(f"{now.isoformat(timespec='seconds')}\t{agent}\t{model}\t{cr}\n")
print("\n".join((r.get("aiRecordDetail") or {}).get("resultObject") or [""]))
print(f"[1min credits: {cr} this call, {used_month+cr:,} this month from GitHub runner of {MONTHLY_CAP:,}]", file=sys.stderr)
